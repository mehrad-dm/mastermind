.DS_Store
*.log
.idea/
.vscode/

# Project-local MasterMind workspace (prefs + generated cycle reports): created
# when USING the brain in a project; never part of the brain repo itself.
.mastermind/

# Client/project pattern packs: LOCAL ONLY, never publish.
# (~/.mastermind is a symlink to this PUBLIC repo, so local-only requires ignoring.)
engineering/fields/*/*-coding-patterns.md
engineering/fields/*/*-coding-patterns/

# ── Lab: quarantine for raw confidential input. NEVER committed. ──────────────
# Sensitive material lands in lab/ only. Analyse it there; commit only the
# genericized OUTPUT (patterns, not identities). Enforced by .githooks/pre-commit.
# Anchored to the repo root (leading slash) so it does NOT also ignore the
# unrelated skills/lab/ skill directory.
/lab/

# ── Private: this repo's own working space. NEVER committed, never released. ──
# Handoffs, session notes, plans, scratch. Distinct from lab/, which is for raw
# confidential INPUT that gets genericized before anything leaves it; nothing in
# private/ is ever meant to ship in any form. HANDOFF.md is here too: it is where
# the handoff skill writes by default.
/private/
/HANDOFF.md

# Skills you write or install into the brain yourself. Outside skills/ on purpose: a user skill
# that collided with a future upstream one made `git pull` abort and froze the brain.
/local/

# Foglamp scan: commit .foglamp/scan.json (public architecture data, no secrets);
# NEVER commit the lock file (holds the secret editToken). The token lives as the
# GitHub Actions secret FOGLAMP_EDIT_TOKEN, used by .github/workflows/foglamp.yml.
/.foglamp/scan.lock.json

# Python bytecode from the vendored ui-ux-pro-max search engine
__pycache__/
*.pyc

# Eval run artifacts: generations, judgements, scratch projects. Reproducible, never committed.
/.eval-run/

# eval raw artifacts: replies, judge outputs, workspaces, results live in SUMMARY.json + RESULTS.md
evals/runs/*/raw/
evals/runs/*/raw-work/

# Local Remotion video workspace and generated media.
/video/
