#!/usr/bin/env bash

set -uo pipefail

RED=$'\033[0;31m'; YEL=$'\033[0;33m'; GRN=$'\033[0;32m'; NC=$'\033[0m'
REPO_ROOT="$(git rev-parse --show-toplevel)"
DENYLIST="$REPO_ROOT/lab/.denylist"
mm_secret_patterns() {
  cat <<'PATTERNS'
gh[pousr]_[A-Za-z0-9]{36,}
github_pat_[A-Za-z0-9_]{20,}
npm_[A-Za-z0-9]{36}
xox[baprs]-[A-Za-z0-9-]{10,}
sk-[A-Za-z0-9]{32,}
sk-ant-[A-Za-z0-9_-]{20,}
AKIA[0-9A-Z]{16}
ASIA[0-9A-Z]{16}
-----BEGIN [A-Z ]*PRIVATE KEY-----
AIza[0-9A-Za-z_-]{35}
PATTERNS
}

# stdin can only be read once, so capture the refs before any loop consumes them.
REFS="$(cat)"

# >>> repo-only: not shipped in skills/quarantine/assets/pre-push ---------------
# A pushed release tag can never be moved: the ruleset forbids it. Everything the release gate
# would check has to be true BEFORE the push, and above the bypass, which is meant for the
# secret scan and must not wave a tag through.
while read -r lref lsha _rref _rsha; do
  case "$lref" in refs/tags/v[0-9]*) ;; *) continue ;; esac
  TAG="${lref#refs/tags/}"; WANT="${TAG#v}"
  tag_refuse() { printf '%s\n' "${RED}✖ BLOCKED: $1${NC}"; printf '%s\n' "  A pushed tag cannot be moved, so the version would be burnt."; exit 1; }

  TARGET="$(git rev-parse -q --verify "$lsha^{commit}" 2>/dev/null)" ||
    tag_refuse "$TAG does not resolve to a commit."
  [ -n "$TARGET" ] || tag_refuse "$TAG does not resolve to a commit."

  # A live fetch every time, never a cached tracking ref: the push reaches the network anyway,
  # and a stale origin/master could vouch for a commit that master no longer contains.
  git fetch -q --no-tags origin master 2>/dev/null ||
    tag_refuse "cannot reach origin to confirm $TAG is on master."
  MASTER="$(git rev-parse -q --verify FETCH_HEAD 2>/dev/null || true)"
  [ -n "$MASTER" ] || tag_refuse "origin/master cannot be read, so $TAG cannot be shown to be on it."
  git merge-base --is-ancestor "$TARGET" "$MASTER" 2>/dev/null ||
    tag_refuse "$TAG points at $(git rev-parse --short "$TARGET"), which is not on master."

  GOT="$(git show "$TARGET:VERSION" 2>/dev/null | tr -d '[:space:]')"
  [ "$GOT" = "$WANT" ] || tag_refuse "$TAG points at a commit whose VERSION is '${GOT:-unreadable}', not $WANT."

  # A here-string, not a pipe: `grep -q` exits early, the writer takes SIGPIPE, and under
  # pipefail that 141 reads as "not found" on a changelog that is perfectly fine.
  LOG="$(git show "$TARGET:CHANGELOG.md" 2>/dev/null || true)"
  grep -q "^## \\[$WANT\\]" <<<"$LOG" ||
    tag_refuse "$TAG has no '## [$WANT]' section in CHANGELOG.md at that commit."

  printf '%s\n' "${GRN}✓ $TAG is on master, VERSION and CHANGELOG agree${NC}"
done <<REFLIST
$REFS
REFLIST
# <<< repo-only ------------------------------------------------------------------

if [ "${ALLOW_SENSITIVE:-0}" = "1" ]; then
  printf '%s\n' "${YEL}⚠  ALLOW_SENSITIVE=1: push guard BYPASSED.${NC}"
  exit 0
fi

TERMS="$({ mm_secret_patterns
  [ -f "$DENYLIST" ] && tr -d '\r' < "$DENYLIST" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' \
    | grep -vE '^(#|$)' | sed 's/[].[^$\\*+?()|{}]/\\&/g'
  } | grep -vE '^$' | paste -sd '|' -)"

FAIL=0
# <local ref> <local sha> <remote ref> <remote sha>
while read -r _lref lsha _rref rsha; do
  [ "$lsha" = "0000000000000000000000000000000000000000" ] && continue

  if [ "$rsha" = "0000000000000000000000000000000000000000" ]; then
    RANGE="$lsha"          # new branch: scan its whole history
  else
    RANGE="$rsha..$lsha"   # only what's new
  fi

  for rev in $(git rev-list "$RANGE" 2>/dev/null); do
    HIT=$(git grep -liE "$TERMS" "$rev" -- . ':(exclude)lab/**' 2>/dev/null || true)
    if [ -n "$HIT" ]; then
      printf '%s\n' "${RED}✖ BLOCKED: commit $(git log -1 --format='%h %s' "$rev") contains confidential terms or credentials:${NC}"
      printf '%s\n' "$HIT" | sed 's/^/    /' | head -5
      FAIL=1
    fi
    # The quarantine itself must never travel, however it got committed.
    QHIT=$(git ls-tree -r --name-only "$rev" 2>/dev/null | grep -E '^lab/' || true)
    if [ -n "$QHIT" ]; then
      printf '%s\n' "${RED}✖ BLOCKED: commit $(git log -1 --format='%h %s' "$rev") carries quarantined files:${NC}"
      printf '%s\n' "$QHIT" | sed 's/^/    /' | head -5
      FAIL=1
    fi
  done
done <<REFLIST
$REFS
REFLIST

if [ "$FAIL" -ne 0 ]; then
  printf '\n%s\n' "${RED}Push aborted: confidential data would become public and permanent.${NC}"
  printf '%s\n' "Rewrite the offending commits before pushing (git filter-repo / interactive rebase)."
  exit 1
fi

printf '%s\n' "${GRN}✓ push guard: clean${NC}"

# >>> repo-only: not shipped in skills/quarantine/assets/pre-push ---------------

# Above MM_SKIP_TESTS on purpose: that flag skips a slow suite, this takes under a second.
if command -v node >/dev/null 2>&1 && [ -f "$REPO_ROOT/scripts/check-prose.mjs" ]; then
  node "$REPO_ROOT/scripts/check-prose.mjs" >/dev/null 2>&1
  case $? in
    0|2) printf '%s\n' "${GRN}✓ no em dashes${NC}" ;;
    *)   printf '%s\n' "${RED}✖ BLOCKED: em dashes would be pushed${NC}"
         node "$REPO_ROOT/scripts/check-prose.mjs" 2>&1 | sed 's/^/    /' | head -12
         exit 1 ;;
  esac
  if ! node "$REPO_ROOT/scripts/check-comments.mjs" >/dev/null 2>&1; then
    printf '%s\n' "${RED}✖ BLOCKED: a comment block is over the house limit${NC}"
    node "$REPO_ROOT/scripts/check-comments.mjs" 2>&1 | sed 's/^/    /' | head -10
    exit 1
  fi
  if ! node "$REPO_ROOT/scripts/check-shell-patterns.mjs" >/dev/null 2>&1; then
    printf '%s\n' "${RED}✖ BLOCKED: a pipeline reader exits early under pipefail${NC}"
    node "$REPO_ROOT/scripts/check-shell-patterns.mjs" 2>&1 | sed 's/^/    /' | head -10
    exit 1
  fi
fi

if [ -n "${MM_SKIP_TESTS:-}" ]; then
  printf '%s\n' "${YEL}⚠ MM_SKIP_TESTS set: pushing WITHOUT running the suite${NC}"
  exit 0
fi

CHANGED="$(git diff --name-only "$(git merge-base HEAD origin/master 2>/dev/null || echo HEAD~1)" HEAD 2>/dev/null || true)"
case "$CHANGED" in
  *install.sh*|*cli/*|*bin/*|*tests/*|*hooks/*|*scripts/*)
    printf '%s\n' "running the suites before this leaves the machine (MM_SKIP_TESTS=1 to skip)…"
    LOG=/tmp/mm-prepush.log
    if ! bash "$REPO_ROOT/tests/install.test.sh" >"$LOG" 2>&1; then
      printf '%s\n' "${RED}✖ BLOCKED: the installer suite fails${NC}"
      grep '✖' "$LOG" | head -10 | sed 's/^/    /'
      printf '%s\n' "  full output: $LOG"
      exit 1
    fi
    if ! bash "$REPO_ROOT/tests/agent-surface.test.sh" >>"$LOG" 2>&1; then
      printf '%s\n' "${RED}✖ BLOCKED: the agent-surface suite fails${NC}"
      tail -12 "$LOG" | sed 's/^/    /'
      exit 1
    fi
    printf '%s\n' "${GRN}✓ suites pass${NC}"
    ;;
  *)
    printf '%s\n' "${GRN}✓ no installer, CLI or script changes here: suite not needed${NC}"
    ;;
esac
# <<< repo-only ------------------------------------------------------------------
exit 0
